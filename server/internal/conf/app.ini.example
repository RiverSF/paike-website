RUN_MODE = debug

[server]

HTTP_PORT     = 80
READ_TIMEOUT  = 60
WRITE_TIMEOUT = 60

[host]

HOST_DEBUG   = http://127.0.0.1
HOST_RELEASE = http://www.river.site

[app]

# 前端构建产物目录，留空表示后端不托管前端（docker compose 下由 nginx 托管）
STATIC_DIR =
# 头像等上传文件存放目录
UPLOAD_DIR  = data/uploads

[postgres]

PG_HOST     = 127.0.0.1
PG_PORT     = 5432
PG_USER     = postgres
PG_PASSWORD = postgres
PG_DB       = tutoring
PG_SSLMODE  = disable
PG_TIMEZONE = Asia/Shanghai

[jwt]

JWT_SECRET       = please-change-this-secret
JWT_EXPIRE_HOURS = 168
